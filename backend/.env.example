# Copy to .env. Git ignores that file. On Railway, set these as service variables.
ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-west-2
# Models run through OpenRouter only. Never use a direct Anthropic key.
OPENROUTER_API_KEY=
SUPABASE_URL=
# Never put this key in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: web search for the agents.
KEENABLE_API_KEY=
